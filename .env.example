# Physical GPU index. The API exposes only one logical CUDA device.
FLASHVSR_DEVICE=0

# Colon-separated directories accepted by input_path and custom output_path.
FLASHVSR_ALLOWED_INPUT_ROOTS=/data/videos

# Optional overrides. Defaults are shown below.
# FLASHVSR_RUNTIME_ROOT=./runtime/api
# FLASHVSR_MODEL_ROOT=./examples/WanVSR/FlashVSR-v1.1
# FLASHVSR_V1_MODEL_ROOT=./examples/WanVSR/FlashVSR
# FLASHVSR_MAX_FRAMES=300
# FLASHVSR_MAX_TARGET_PIXELS=2000000
# FLASHVSR_HOST=127.0.0.1
# FLASHVSR_PORT=18302
